<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="ic_tray_mobile">
    <pose>-2.30 -1.20 0 0 0 3.14159265359</pose>
    <link name="base_link">
      <inertial>
        <pose>0 0 0.14 0 0 0</pose>
        <mass>20</mass>
        <inertia>
          <ixx>0.347</ixx>
          <iyy>0.897</iyy>
          <izz>1.083</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.4 0.22</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.4 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.23 0.39 0.48 1</ambient>
          <diffuse>0.23 0.39 0.48 1</diffuse>
        </material>
      </visual>
      <collision name="front_support_collision">
        <pose>0.28 0 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="rear_support_collision">
        <pose>-0.28 0 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_support">
        <pose>0.28 0 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>
      <visual name="rear_support">
        <pose>-0.28 0 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>
      <sensor name="laser" type="gpu_lidar">
        <pose>0.32 0 0.34 0 0 0</pose>
        <topic>/model/ic_tray_mobile/scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>361</samples>
              <resolution>1</resolution>
              <min_angle>-1.57079632679</min_angle>
              <max_angle>1.57079632679</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.2 0.075 1.57079632679 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00224</ixx>
          <iyy>0.00224</iyy>
          <izz>0.0028125</izz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.11 0.12 0.14 1</ambient>
          <diffuse>0.11 0.12 0.14 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.2 0.075 1.57079632679 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.00224</ixx>
          <iyy>0.00224</iyy>
          <izz>0.0028125</izz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.11 0.12 0.14 1</ambient>
          <diffuse>0.11 0.12 0.14 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
      </axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <topic>/model/ic_tray_mobile/cmd_vel</topic>
      <odom_topic>/model/ic_tray_mobile/odometry</odom_topic>
      <tf_topic>/model/ic_tray_mobile/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
