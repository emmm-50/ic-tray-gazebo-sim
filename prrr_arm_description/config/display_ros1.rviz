Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 160
    - Class: rviz/RobotModel
      Name: Complete PRRR arm
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Robot Description: robot_description
  Global Options:
    Background Color: 45; 48; 53
    Fixed Frame: base_footprint
    Frame Rate: 30
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.55
      Focal Point:
        X: 0.24
        Y: 0.0
        Z: 0.34
      Pitch: 0.35
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 850
