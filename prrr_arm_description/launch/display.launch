<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <param name="robot_description" textfile="$(find prrr_arm_description)/urdf/prrr_arm.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
  <node if="$(arg gui)" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher" output="screen">
    <rosparam command="load" file="$(find prrr_arm_description)/config/cad_pose.yaml"/>
  </node>
  <node unless="$(arg gui)" pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" output="screen">
    <rosparam command="load" file="$(find prrr_arm_description)/config/cad_pose.yaml"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find prrr_arm_description)/config/display_ros1.rviz"/>
</launch>
